.page {
    box-sizing: border-box;
    min-height: 100vh;
    background: #faf8f4;
    padding: 0 44rpx;
    display: flex;
    flex-direction: column;
}

.hero {
    padding-top: 140rpx;
}

.eyebrow {
    display: block;
    font-size: 22rpx;
    color: #b8b2a8;
    letter-spacing: 8rpx;
}

.title {
    display: block;
    margin-top: 40rpx;
    font-size: 56rpx;
    line-height: 1.45;
    color: #2c2c2a;
}

.subtitle {
    display: block;
    margin-top: 28rpx;
    font-size: 26rpx;
    line-height: 1.85;
    color: #8d8880;
}

.date-field {
    margin-top: 100rpx;
    padding: 40rpx 0;
    border-top: 1rpx solid #e6e0d4;
    border-bottom: 1rpx solid #e6e0d4;
    display: flex;
    flex-direction: column;
    gap: 16rpx;
}

.date-value {
    font-size: 46rpx;
    color: #2c2c2a;
    letter-spacing: 1rpx;
}

.date-hint {
    font-size: 22rpx;
    color: #b8b2a8;
}

.actions {
    margin-top: 96rpx;
}

.primary-button {
    width: 100%;
    height: 96rpx;
    line-height: 96rpx;
    background: #2c2c2a;
    color: #faf8f4;
    font-size: 30rpx;
    border-radius: 14rpx;
}

.foot {
    margin-top: auto;
    padding: 60rpx 0 72rpx;
    font-size: 21rpx;
    line-height: 1.8;
    color: #c3bdb2;
    text-align: center;
}
