.page {
    box-sizing: border-box;
    min-height: 100vh;
    background: #faf8f4;
    padding-bottom: 200rpx;
}

/* ============ 视图切换 ============ */
.modebar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: #faf8f4;
    padding: 20rpx 32rpx 16rpx;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.nav-entry {
    font-size: 24rpx;
    color: #5f5e5a;
    padding: 8rpx 4rpx;
    letter-spacing: 1rpx;
}

.seg {
    display: flex;
    background: #efebe2;
    border-radius: 999rpx;
    padding: 4rpx;
}

.seg-item {
    height: 48rpx;
    line-height: 48rpx;
    padding: 0 28rpx;
    font-size: 24rpx;
    color: #8d8880;
    border-radius: 999rpx;
}

.seg-on {
    background: #ffffff;
    color: #2c2c2a;
}

/* seg 实际高度 = 4+48+4 = 56rpx，modebar = 20+56+16 = 92rpx */
.group {
    position: relative;
}

/* ============ 年度刻度（吸顶） ============ */
.year-head {
    position: sticky;
    top: 92rpx;
    z-index: 10;
    background: #faf8f4;
    display: flex;
    align-items: baseline;
    gap: 16rpx;
    padding: 28rpx 32rpx 12rpx;
}

.year {
    font-size: 34rpx;
    color: #2c2c2a;
    letter-spacing: 1rpx;
}

.year-age {
    font-size: 22rpx;
    color: #a8a29a;
}

.year-more {
    margin-left: auto;
    font-size: 21rpx;
    color: #c3bdb2;
}

/* ============ 节点 ============ */
.node {
    display: flex;
    padding: 0 32rpx 0 32rpx;
}

.rail {
    width: 40rpx;
    flex: none;
    position: relative;
    display: flex;
    justify-content: center;
    padding-top: 30rpx;
}

.rail::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1rpx;
    background: #e6e0d4;
    transform: translateX(-50%);
}

.dot {
    width: 12rpx;
    height: 12rpx;
    border-radius: 50%;
    background: #cfc8b8;
    position: relative;
    z-index: 1;
    flex: none;
}

.dot-strong {
    background: #993c1d;
    width: 14rpx;
    height: 14rpx;
}

/* ============ 卡片 ============ */
.card {
    flex: 1;
    min-width: 0;
    margin-bottom: 26rpx;
    border-radius: 16rpx;
    overflow: hidden;
}

.card-cover {
    display: block;
    width: 100%;
    height: 320rpx;
    background: #ece7dd;
}

.card-body {
    padding: 22rpx 24rpx;
}

.card-title {
    display: block;
    font-size: 32rpx;
    line-height: 1.45;
    color: #2c2c2a;
}

.card-excerpt {
    display: block;
    margin-top: 10rpx;
    font-size: 25rpx;
    line-height: 1.65;
    color: #8d8880;
}

.card-meta {
    margin-top: 12rpx;
    font-size: 21rpx;
    color: #a8a29a;
    letter-spacing: 0.5rpx;
}

/* 纯图 / 有图：白底卡片 */
.card-photo {
    background: #ffffff;
    border: 1rpx solid #ece7dd;
}

/* 里程碑：无卡片容器，靠字号取胜 */
.card-milestone {
    background: transparent;
    border: none;
    padding: 4rpx 0 0;
}

.card-milestone .card-body {
    padding: 0;
}

.card-milestone .card-title {
    font-size: 40rpx;
    line-height: 1.4;
}

/* 摘录：竖线 + 引言体 */
.card-quote {
    background: transparent;
    border: none;
    border-left: 3rpx solid #ddd6c8;
    border-radius: 0;
}

.card-quote .card-body {
    padding: 0 0 0 22rpx;
}

.card-quote .card-excerpt {
    margin-top: 0;
    color: #5f5e5a;
    font-size: 26rpx;
}

/* 纯文字：轻描边 */
.card-plain {
    background: #ffffff;
    border: 1rpx solid #ece7dd;
}

.card-plain .card-title {
    font-size: 28rpx;
}

/* ============ 摘要与收尾 ============ */
.summary {
    display: flex;
    align-items: baseline;
    gap: 14rpx;
    padding: 8rpx 32rpx 12rpx;
}

.summary-main {
    font-size: 24rpx;
    color: #5f5e5a;
}

.summary-sub {
    font-size: 22rpx;
    color: #b8b2a8;
}

.tail {
    padding: 40rpx 0 20rpx;
    text-align: center;
    font-size: 21rpx;
    color: #c3bdb2;
    letter-spacing: 2rpx;
}

/* ============ 空状态 ============ */
.empty {
    padding: 88rpx 40rpx 32rpx;
}

.empty-eyebrow {
    display: block;
    font-size: 22rpx;
    color: #a8a29a;
    letter-spacing: 2rpx;
}

.empty-title {
    display: block;
    margin-top: 18rpx;
    font-size: 52rpx;
    line-height: 1.3;
    color: #2c2c2a;
}

.empty-sub {
    display: block;
    margin-top: 20rpx;
    font-size: 26rpx;
    line-height: 1.7;
    color: #8d8880;
}

.seeds {
    margin: 32rpx 32rpx 0;
    background: #ffffff;
    border: 1rpx solid #ece7dd;
    border-radius: 20rpx;
    overflow: hidden;
}

.seed {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 30rpx 28rpx;
    border-bottom: 1rpx solid #f2eee6;
}

.seed:last-child {
    border-bottom: none;
}

.seed-text {
    font-size: 30rpx;
    color: #2c2c2a;
}

.seed-plus {
    font-size: 28rpx;
    color: #c3bdb2;
}

/* ============ 草稿条 ============ */
.draft-bar {
    margin: 8rpx 32rpx 20rpx;
    padding: 22rpx 24rpx;
    background: #f3ece2;
    border-radius: 14rpx;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.draft-text {
    font-size: 24rpx;
    color: #7a5a3a;
}

.draft-act {
    font-size: 24rpx;
    color: #993c1d;
}

/* ============ 人生格 ============ */
.grid-head {
    padding: 40rpx 40rpx 28rpx;
}

.grid-title {
    display: block;
    font-size: 40rpx;
    color: #2c2c2a;
    line-height: 1.4;
}

.grid-sub {
    display: block;
    margin-top: 14rpx;
    font-size: 24rpx;
    line-height: 1.7;
    color: #8d8880;
}

.grid {
    display: flex;
    flex-wrap: wrap;
    padding: 0 30rpx;
}

/* 30 格 × (20 + 1.5*2) = 690rpx，正好铺满 750 - 30*2 */
.cell {
    width: 20rpx;
    height: 20rpx;
    margin: 1.5rpx;
    border-radius: 2rpx;
}

.cell-0 {
    background: #ece7dd;
}

.cell-1 {
    background: #cfc8b8;
}

.cell-2 {
    background: #993c1d;
}

.legend {
    display: flex;
    justify-content: center;
    gap: 36rpx;
    padding: 32rpx 0 8rpx;
    font-size: 22rpx;
    color: #8d8880;
}

.legend-item {
    display: flex;
    align-items: center;
    gap: 10rpx;
}

.legend-dot {
    width: 20rpx;
    height: 20rpx;
    border-radius: 2rpx;
}

.grid-foot {
    padding: 16rpx 0 40rpx;
    text-align: center;
    font-size: 21rpx;
    color: #c3bdb2;
}

.origin {
    display: flex;
    align-items: center;
    gap: 16rpx;
    margin: 0 32rpx 40rpx;
    padding: 26rpx 28rpx;
    background: #ffffff;
    border: 1rpx solid #ece7dd;
    border-radius: 16rpx;
}

.origin-k {
    font-size: 21rpx;
    color: #a8a29a;
    letter-spacing: 2rpx;
}

.origin-v {
    flex: 1;
    font-size: 26rpx;
    color: #2c2c2a;
}

.origin-edit {
    font-size: 22rpx;
    color: #993c1d;
}

/* ============ 悬浮录入 ============ */
.fab {
    position: fixed;
    right: 44rpx;
    bottom: 64rpx;
    width: 104rpx;
    height: 104rpx;
    border-radius: 50%;
    background: #2c2c2a;
    color: #faf8f4;
    font-size: 44rpx;
    line-height: 100rpx;
    text-align: center;
    z-index: 30;
    box-shadow: 0 10rpx 28rpx rgba(44, 44, 42, 0.18);
}
