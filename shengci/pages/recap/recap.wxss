.page {
    box-sizing: border-box;
    min-height: 100vh;
    background: #f3efe7;
    padding: 0 30rpx 80rpx;
}

/* ============ 年份选择 ============ */
.yearbar {
    display: flex;
    align-items: baseline;
    gap: 16rpx;
    padding: 32rpx 4rpx 24rpx;
}

.year-pick {
    display: flex;
    align-items: baseline;
    gap: 10rpx;
}

.year-num {
    font-size: 40rpx;
    color: #2c2c2a;
}

.chev {
    font-size: 22rpx;
    color: #a8a29a;
}

.year-hint {
    font-size: 22rpx;
    color: #a8a29a;
}

/* ============ 卡片 ============ */
.card-wrap {
    display: flex;
    justify-content: center;
}

.card {
    border-radius: 8rpx;
    background: #faf8f4;
    box-shadow: 0 6rpx 24rpx rgba(44, 44, 42, 0.08);
}

.tips {
    padding: 28rpx 8rpx 0;
    font-size: 22rpx;
    color: #a8a29a;
    text-align: center;
}

/* ============ 操作 ============ */
.actions {
    padding: 44rpx 0 0;
}

.btn {
    height: 92rpx;
    line-height: 92rpx;
    text-align: center;
    font-size: 28rpx;
    color: #faf8f4;
    background: #2c2c2a;
    border-radius: 14rpx;
}
