<view class="page">

    <!-- 三步进度 -->
    <view class="steps">
        <view class="step {{step === 0 ? 'cur' : ''}} {{step > 0 ? 'done' : ''}}" data-step="0" bindtap="jumpStep">
            <text class="step-num">1</text>
            <text class="step-name">照片</text>
        </view>
        <view class="step-line {{step > 0 ? 'line-done' : ''}}"></view>
        <view class="step {{step === 1 ? 'cur' : ''}} {{step > 1 ? 'done' : ''}}" data-step="1" bindtap="jumpStep">
            <text class="step-num">2</text>
            <text class="step-name">时间</text>
        </view>
        <view class="step-line {{step > 1 ? 'line-done' : ''}}"></view>
        <view class="step {{step === 2 ? 'cur' : ''}}" data-step="2" bindtap="jumpStep">
            <text class="step-num">3</text>
            <text class="step-name">一句话</text>
        </view>
    </view>

    <!-- ===== 第一步：照片 ===== -->
    <view class="body" wx:if="{{step === 0}}">
        <text class="q serif">有什么画面可以放进来？</text>
        <text class="hint">没有照片也可以，直接往下走。</text>

        <view class="photo-grid">
            <view class="photo-item" wx:for="{{photos}}" wx:key="*this">
                <image class="photo-img" src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="previewPhoto"></image>
                <view class="photo-del" data-index="{{index}}" catchtap="removePhoto">×</view>
            </view>
            <view class="photo-add" wx:if="{{photos.length < maxPhotos}}" bindtap="choosePhoto">
                <text class="photo-add-icon">＋</text>
            </view>
        </view>
    </view>

    <!-- ===== 第二步：时间（可模糊） ===== -->
    <view class="body" wx:elif="{{step === 1}}">
        <text class="q serif">这件事发生在什么时候？</text>
        <text class="hint">记不清具体哪一天没关系，选一个你记得的粒度。</text>

        <view class="precision-list">
            <view class="precision-item {{precisionIndex === index ? 'on' : ''}}" wx:for="{{precisions}}" wx:key="code" data-index="{{index}}" bindtap="onPrecisionTap">
                <text class="precision-label">{{item.label}}</text>
                <view class="check" wx:if="{{precisionIndex === index}}"></view>
            </view>
        </view>

        <view class="time-panel" wx:if="{{precision !== 'unknown'}}">
            <picker wx:if="{{precision === 'day'}}" mode="date" value="{{dayValue}}" start="1900-01-01" end="2100-12-31" bindchange="onDayChange">
                <view class="time-value serif">{{timeLabel}}<text class="time-edit">修改</text></view>
            </picker>
            <picker wx:else mode="multiSelector" range="{{columns}}" value="{{indexes}}" bindchange="onTimeChange" bindcolumnchange="onColumnChange">
                <view class="time-value serif">{{timeLabel}}<text class="time-edit">修改</text></view>
            </picker>
        </view>

        <view class="time-panel" wx:else>
            <text class="time-note">没关系。这条会单独归到「记不清的日子」，不占时间轴上的具体位置。</text>
        </view>
    </view>

    <!-- ===== 第三步：一句话 ===== -->
    <view class="body" wx:else>
        <text class="q serif">这件事，你想怎么记它？</text>

        <input class="title-input serif" value="{{title}}" placeholder="一句话就够" placeholder-class="ph" maxlength="40" bindinput="onTitleInput" bindblur="onTitleBlur" />

        <view class="more-toggle" bindtap="toggleMore">
            <text>{{showMore ? '收起' : '补充更多'}}</text>
            <text class="more-arrow">{{showMore ? '︿' : '﹀'}}</text>
        </view>

        <view class="more" wx:if="{{showMore}}">
            <view class="row">
                <text class="row-label">类型</text>
                <picker mode="selector" range="{{types}}" value="{{typeIndex}}" bindchange="onTypeChange">
                    <view class="row-value">{{types[typeIndex]}}<text class="chev">›</text></view>
                </picker>
            </view>
            <view class="row">
                <text class="row-label">心情</text>
                <picker mode="selector" range="{{emotionOptions}}" value="{{emotionIndex}}" bindchange="onEmotionChange">
                    <view class="row-value">{{emotionOptions[emotionIndex]}}<text class="chev">›</text></view>
                </picker>
            </view>
            <view class="row">
                <text class="row-label">地点</text>
                <input class="row-input" value="{{place}}" placeholder="只记得城市也行" placeholder-class="ph" maxlength="30" bindinput="onPlaceInput" bindblur="saveDraft" />
            </view>
            <view class="block">
                <text class="row-label">想说的</text>
                <textarea class="content-input" value="{{content}}" placeholder="那时候的细节，以后会想看的。" placeholder-class="ph" maxlength="1000" auto-height bindinput="onContentInput" bindblur="saveDraft"></textarea>
            </view>
        </view>
    </view>

    <!-- 底部操作 -->
    <view class="footer">
        <view class="btn-ghost" bindtap="goPrev">{{step === 0 ? '取消' : '上一步'}}</view>
        <view class="btn-primary" bindtap="goNext">{{step === 2 ? (editingId ? '保存修改' : '记下来') : '下一步'}}</view>
    </view>
</view>
