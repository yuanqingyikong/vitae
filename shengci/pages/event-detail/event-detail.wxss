.page {
    box-sizing: border-box;
    min-height: 100vh;
    background: #faf8f4;
    padding: 48rpx 44rpx 120rpx;
}

/* ============ 头部 ============ */
.head {
    display: flex;
    align-items: baseline;
    gap: 16rpx;
}

.date {
    font-size: 28rpx;
    color: #993c1d;
    letter-spacing: 1rpx;
}

.age {
    font-size: 22rpx;
    color: #b8b2a8;
}

.title {
    display: block;
    margin-top: 26rpx;
    font-size: 54rpx;
    line-height: 1.45;
    color: #2c2c2a;
}

/* ============ 照片 ============ */
.photos {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
    margin-top: 44rpx;
}

.photo {
    width: calc((100% - 12rpx) / 2);
    height: 300rpx;
    border-radius: 12rpx;
    background: #ece7dd;
    display: block;
}

.photos-single .photo {
    width: 100%;
    height: 480rpx;
}

/* ============ 正文 ============ */
.content {
    margin-top: 44rpx;
    font-size: 30rpx;
    line-height: 2;
    color: #3a3a36;
    letter-spacing: 0.5rpx;
}

/* ============ 元信息 ============ */
.meta {
    margin-top: 56rpx;
    border-top: 1rpx solid #ece7dd;
}

.meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 26rpx 0;
    border-bottom: 1rpx solid #f2eee6;
}

.meta-k {
    font-size: 24rpx;
    color: #a8a29a;
}

.meta-v {
    font-size: 26rpx;
    color: #5f5e5a;
}

/* ============ 操作 ============ */
.actions {
    display: flex;
    gap: 20rpx;
    margin-top: 64rpx;
}

.act {
    flex: 1;
    height: 88rpx;
    line-height: 88rpx;
    text-align: center;
    font-size: 27rpx;
    color: #5f5e5a;
    border: 1rpx solid #ddd6c8;
    border-radius: 14rpx;
}

.act-danger {
    color: #993c1d;
    border-color: #e3d0c5;
}
