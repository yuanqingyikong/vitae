<view class="page">

    <view class="facetbar">
        <view class="facet {{facet === item.code ? 'on' : ''}}" wx:for="{{facets}}" wx:key="code" data-code="{{item.code}}" bindtap="switchFacet">{{item.label}}</view>
    </view>

    <view class="state-card" wx:if="{{viewState === 'loading'}}">
        <view class="spinner"></view>
        <text class="state-title">正在整理</text>
    </view>

    <view class="state-card" wx:elif="{{viewState === 'empty'}}">
        <text class="state-title">还没有照片</text>
        <text class="state-description">在时间轴里记一件事、放上照片，这里就会长出来。</text>
        <button class="primary-button" bindtap="goCreate">去记一件</button>
    </view>

    <block wx:else>
        <view class="count">{{total}} 张照片</view>

        <view class="section" wx:for="{{sections}}" wx:key="key" wx:for-item="sec" wx:for-index="si">
            <view class="sec-head">
                <text class="sec-title serif">{{sec.title}}</text>
                <text class="sec-sub">{{sec.subtitle}}</text>
            </view>

            <view class="thumbs">
                <image class="thumb" wx:for="{{sec.photos}}" wx:key="path" wx:for-item="ph" wx:for-index="pi" src="{{ph.path}}" mode="aspectFill" lazy-load data-si="{{si}}" data-pi="{{pi}}" bindtap="preview"></image>
            </view>
        </view>

        <view class="tail">—— 照片按事件落位，换个切面重新看 ——</view>
    </block>
</view>
